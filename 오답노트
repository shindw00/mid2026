14. 배열 {3, 1, 2, 5, 4}의 정수 5개를 C언어 표준 라이브러리 함수 qsort()를 활용하여 내림차순으로 정렬하고 출력하는 프로그램을 작성하시오.
#include <stdio.h>
#include <stdlib.h>

int compare(const void *a, const void *b) {
    return *(int *)b - *(int *)a;
}

int main(void) {
    int arr[] = {3, 1, 2, 5, 4};
    qsort(arr, 5, sizeof(int), compare);
    for (int i = 0; i < 5; i++)
        printf("%d ", arr[i]);
    return 0;
}

15. 주사위를 6,000번 던졌을 때, 1부터 6까지의 각 눈이 나올 횟수를 구하는 C언어 프로그램을 작성하시오.
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int count[6] = {0};
    for (int i = 0; i < 6000; i++)
        count[rand() % 6]++;
    for (int i = 0; i < 6; i++)
        printf("[%d] %d\n", i + 1, count[i]);
    return 0;
}
